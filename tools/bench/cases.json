[
 {
  "name": "arith",
  "expr": "x + y * 2 - z / 3 > 10 && x % 7 != 0",
  "variables": {
   "x": "int",
   "y": "int",
   "z": "int"
  },
  "bindings": {
   "x": "120",
   "y": "35",
   "z": "9"
  }
 },
 {
  "name": "select-chain",
  "expr": "a.b.c.d == 1 && has(a.b.e) && a.b['c']['d'] + 1 == 2 && a.f[2] == 'z'",
  "variables": {
   "a": "map(string, dyn)"
  },
  "bindings": {
   "a": "{'b': {'c': {'d': 1}, 'e': true}, 'f': ['x', 'y', 'z']}"
  }
 },
 {
  "name": "literals",
  "expr": "{'a': x, 'b': [x, x + 1, x + 2], 'c': {'d': string(x)}}.size() == 3",
  "variables": {
   "x": "int"
  },
  "bindings": {
   "x": "7"
  }
 },
 {
  "name": "policy",
  "expr": "!pr.draft\n  && pr.additions + pr.deletions <= 400\n  && review.confidence >= 0.85\n  && review.risk in ['low', 'medium']\n  && (review.approvals >= 2 || pr.author in ['octocat', 'hubot'])\n  && !('do-not-merge' in pr.labels)\n  && pr.labels.exists(l, l == 'bug' || l.startsWith('feat'))\n  && pr.files.all(f, !f.path.endsWith('.lock') && f.changes < 500)",
  "variables": {
   "pr": "map(string, dyn)",
   "review": "map(string, dyn)"
  },
  "bindings": {
   "pr": "{'additions': 120, 'deletions': 30, 'author': 'octocat', 'draft': false, 'labels': ['bug', 'backend', 'needs-review'], 'files': lists.range(40).map(i, {'path': 'src/module' + string(i % 7) + '/file' + string(i) + '.swift', 'changes': i * 3})}",
   "review": "{'confidence': 0.91, 'risk': 'low', 'approvals': 2}"
  }
 },
 {
  "name": "comprehension-map-filter",
  "expr": "xs.map(x, x * 2).filter(y, y % 3 == 0).map(z, z + 1).size() > 0",
  "variables": {
   "xs": "list(int)"
  },
  "bindings": {
   "xs": "lists.range(1000)"
  }
 },
 {
  "name": "comprehension-nested",
  "expr": "xs.all(x, ys.exists(y, y == x % 50))",
  "variables": {
   "xs": "list(int)",
   "ys": "list(int)"
  },
  "bindings": {
   "xs": "lists.range(200)",
   "ys": "lists.range(50)"
  }
 },
 {
  "name": "string-ops",
  "expr": "pr.files.filter(f, f.path.contains('module3')).map(f, f.path.size()).size() >= 1",
  "variables": {
   "pr": "map(string, dyn)"
  },
  "bindings": {
   "pr": "{'files': lists.range(40).map(i, {'path': 'src/module' + string(i % 7) + '/file' + string(i) + '.swift', 'changes': i * 3})}"
  }
 },
 {
